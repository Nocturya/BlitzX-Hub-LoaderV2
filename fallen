local function send_webhook(payloadJson)
    local ok, _ = pcall(function()
        HttpService:PostAsync(webhookUrl, payloadJson, Enum.HttpContentType.ApplicationJson)
    end)
    if ok then return true end

    if type(syn) == "table" and type(syn.request) == "function" then
        local ok2, r2 = pcall(function()
            return syn.request({
                Url = webhookUrl,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = payloadJson
            })
        end)
        if ok2 and r2 and (r2.StatusCode == 200 or r2.StatusCode == 204) then return true end
    end

    local requestFuncs = { http_request, request, (http and http.request) and http.request or nil }
    for _, fn in ipairs(requestFuncs) do
        if type(fn) == "function" then
            local ok3 = pcall(function() fn({ Url = webhookUrl, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = payloadJson }) end)
            if ok3 then return true end
        end
    end

    return false
end

