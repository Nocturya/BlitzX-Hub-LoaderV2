def delete_folder(path: Path):
    if path.exists() and path.is_dir():
        try:
            shutil.rmtree(path, ignore_errors=True)
            print_ok(f"Deleted: {path}")
        except Exception as e:
            print_fail(f"Failed: {path} → {e}")
    else:
