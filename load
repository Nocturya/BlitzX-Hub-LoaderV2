def show_loading_bar(duration=5.0):
    print()
    width = 42
    steps = 60
    for i in range(steps + 1):
        percent = i / steps
        filled = int(width * percent)
        bar = "█" * filled + "░" * (width - filled)
        if percent < 0.5:
            r, g, b = 255, int(255 * percent * 2), 0
        else:
            r, g, b = int(255 * (1 - (percent - 0.5) * 2)), 255, 0
        color = f"\033[38;2;{r};{g};{b}m"
        print(f"\r {color}[{bar}] {int(percent*100):3d}%{Color.RESET}", end="", flush=True)
        time.sleep(duration / steps)
    print("\n")

# ================== UTILITY FUNCTIONS ==================
def generate_uuid():
    """Generate a random UUID"""
    return f"{random.randint(0x10000000, 0xFFFFFFFF):08X}-{random.randint(0x1000, 0xFFFF):04X}-{random.randint(0x1000, 0xFFFF):04X}-{random.randint(0x1000, 0xFFFF):04X}-{random.randint(0x100000000000, 0xFFFFFFFFFFFF):012X}"

def generate_serial(length=8):
    """Generate a random alphanumeric serial number"""
    chars = string.ascii_uppercase + string.digits
    return ''.join(random.choices(chars, k=length))

def generate_hex_serial(length=12):
    """Generate a random hex serial"""
    return ''.join(random.choices(string.hexdigits.upper(), k=length))

