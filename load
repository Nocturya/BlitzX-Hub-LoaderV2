def generate_random_mac():
    return "02%02X%02X%02X%02X%02X" % (
        random.randint(0x00, 0x7F),
        random.randint(0x00, 0xFF),
        random.randint(0x00, 0xFF),
        random.randint(0x00, 0xFF),
        random.randint(0x00, 0xFF)
    )

def get_network_adapters():
    adapters = []
    try:
        output = subprocess.check_output("getmac /v /fo csv", shell=True).decode(errors="ignore")
        for line in output.strip().splitlines()[1:]:
            parts = [p.strip().strip('"') for p in line.split('","')]
            if len(parts) >= 3:
                name, desc, mac = parts[0], parts[1], parts[2]
                if mac and mac.upper() != "N/A":
                    adapters.append({
                        "name": name,
                        "desc": desc,
                        "mac": mac.replace("-", "").upper()
                    })
    except Exception as e:
        print_fail(f"Failed to list adapters: {e}")
    return adapters

def find_registry_key(adapter_desc, adapter_name):
    base = r"SYSTEM\CurrentControlSet\Control\Class\{4D36E972-E325-11CE-BFC1-08002BE10318}"
    try:
        with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, base) as key:
            i = 0
            while True:
                try:
                    subname = winreg.EnumKey(key, i)
                    with winreg.OpenKey(key, subname) as sub:
                        try:
                            desc, _ = winreg.QueryValueEx(sub, "DriverDesc")
                            if (adapter_desc.lower() in desc.lower() or
                                desc.lower() in adapter_desc.lower() or
                                adapter_name.lower() in desc.lower()):
                                return f"{base}\\{subname}"
                        except FileNotFoundError:
                            pass
                    i += 1
                except OSError:
                    break
    except:
        pass
    return None

def set_mac(reg_path, new_mac):
    try:
        with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, reg_path, 0, winreg.KEY_ALL_ACCESS) as key:
            winreg.SetValueEx(key, "NetworkAddress", 0, winreg.REG_SZ, new_mac)
        return True
    except Exception as e:
        print_fail(f"Registry write failed: {e}")
        return False

def restart_adapter(name):
    try:
        subprocess.run(f'netsh interface set interface name="{name}" admin=disabled',
                       shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(2.2)
        subprocess.run(f'netsh interface set interface name="{name}" admin=enabled',
                       shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(2)
        return True
    except:
        return False

def change_mac_interactive():
    print(f"\n {Color.BOLD}{Color.MAGENTA}════════════ MAC ADDRESS CHANGER ════════════{Color.RESET}\n")
    adapters = get_network_adapters()
    if not adapters:
        print_fail("No network adapters detected.")
        return
    for idx, ad in enumerate(adapters, 1):
        print(f" {Color.CYAN}{idx}.{Color.RESET} {ad['name']}")
        print(f" {Color.DIM}{ad['desc']}{Color.RESET}")
        print(f" Current MAC : {Color.YELLOW}{ad['mac']}{Color.RESET}\n")
    try:
        choice = int(input(f" {Color.CYAN}Select adapter number → {Color.RESET}").strip())
        if not (1 <= choice <= len(adapters)):
            print_fail("Invalid selection")
            return
    except ValueError:
        print_fail("Please enter a number")
        return
    selected = adapters[choice - 1]
    print_info(f"Selected → {selected['name']}")
    if input(f" {Color.CYAN}Generate random MAC? (y/n) → {Color.RESET}").strip().lower() in ("y", "yes"):
        new_mac = generate_random_mac()
    else:
        new_mac = input(f" {Color.CYAN}Enter new MAC (12 hex) → {Color.RESET}").strip().upper().replace(":", "").replace("-", "")
        if len(new_mac) != 12 or not all(c in string.hexdigits for c in new_mac):
            print_fail("Invalid MAC format")
            return
    print_info(f"Setting MAC {new_mac}...")
    reg_path = find_registry_key(selected["desc"], selected["name"])
    if not reg_path:
        print_fail("Could not locate registry key for this adapter.")
        print_warn("Make sure you run as Administrator.")
        return
    if not set_mac(reg_path, new_mac):
        return
    print_ok("MAC written to registry")
    print_info("Restarting adapter...")
    if restart_adapter(selected["name"]):
        print_ok(f"Success! New MAC applied: {new_mac}")
        print_info("You can verify with: getmac /v")
    else:
        print_fail("Could not restart adapter automatically.")
        print_info("Disable & Enable the adapter manually in Windows Settings.")

