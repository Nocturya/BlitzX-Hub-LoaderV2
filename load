def delete_key_recursive(hive, path):
    try:
        with winreg.OpenKey(hive, path, 0, winreg.KEY_ALL_ACCESS) as key:
            while True:
                try:
                    sub = winreg.EnumKey(key, 0)
                    delete_key_recursive(hive, f"{path}\\{sub}")
                except OSError:
                    break
        winreg.DeleteKey(hive, path)
        return True
    except FileNotFoundError:
        return False
    except Exception:
        return False

def clean_registry():
    print_info("Cleaning Roblox registry keys...")
    keys = [
        (winreg.HKEY_CURRENT_USER, r"Software\Roblox"),
        (winreg.HKEY_CURRENT_USER, r"Software\ROBLOX Corporation"),
        (winreg.HKEY_CURRENT_USER, r"Software\Classes\roblox-player"),
        (winreg.HKEY_CURRENT_USER, r"Software\Classes\roblox-studio"),
        (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\ROBLOX Corporation"),
        (winreg.HKEY_LOCAL_MACHINE, r"SOFTWARE\Classes\roblox-player"),
    ]
    for hive, path in keys:
        if delete_key_recursive(hive, path):
            print_ok(f"Deleted: {path}")
        else:
            print_skip(f"Already clean: {path}")

def clean_temp():
    print_info("Cleaning temporary files...")
    for temp in [Path(os.environ.get("TEMP", "")), Path(r"C:\Windows\Temp")]:
        if not temp.exists():
            continue
        try:
            for item in temp.iterdir():
                try:
                    if item.is_file():
                        item.unlink(missing_ok=True)
                    elif item.is_dir() and "roblox" in item.name.lower():
                        shutil.rmtree(item, ignore_errors=True)
                except:
                    pass
            print_ok(f"Cleaned: {temp}")
        except Exception as e:
            print_fail(f"Temp error: {e}")

