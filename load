    def spoof_volume_serial(self):
        """Change Volume Serial Number (NTFS/FAT boot sector)"""
        try:
            volumes_modified = 0
            
            for drive in 'ABCDEFGHIJKLMNOPQRSTUVWXYZ':
                drive_path = f"{drive}:\\"
                
                if not os.path.exists(drive_path):
                    continue
                
                try:
                    # Get volume info
                    kernel32 = ctypes.windll.kernel32
                    
                    volume_name = ctypes.create_unicode_buffer(256)
                    file_system = ctypes.create_unicode_buffer(256)
                    serial = ctypes.c_uint32()
                    
                    result = kernel32.GetVolumeInformationW(
                        ctypes.c_wchar_p(drive_path),
                        volume_name, 256,
                        ctypes.byref(serial),
                        None, None,
                        file_system, 256
                    )
                    
                    if result:
                        old_serial = serial.value
                        new_serial = random.randint(0x10000000, 0xFFFFFFFF)
                        
                        # Use FSCTL to change serial
                        # Note: This requires direct disk access
                        device_path = f"\\\\.\\{drive}:"
                        
                        handle = kernel32.CreateFileW(
                            device_path,
                            0xC0000000,  # GENERIC_READ | GENERIC_WRITE
                            3,  # FILE_SHARE_READ | FILE_SHARE_WRITE
                            None,
                            3,  # OPEN_EXISTING
                            0,
                            None
                        )
                        
                        if handle != -1:
                            # Read boot sector
                            boot_sector = ctypes.create_string_buffer(512)
                            bytes_returned = ctypes.c_uint32()
                            
                            # DeviceIoControl for reading
                            kernel32.ReadFile(handle, boot_sector, 512, 
                                ctypes.byref(bytes_returned), None)
                            
                            # Modify serial in boot sector (offset 0x48 for NTFS, 0x27 for FAT32, 0x27 for FAT16)
                            fs_name = file_system.value.upper()
                            
                            if 'NTFS' in fs_name:
                                # NTFS serial at offset 0x48
                                boot_sector[0x48:0x4C] = struct.pack('<I', new_serial)
                            elif 'FAT32' in fs_name:
                                # FAT32 serial at offset 0x43
                                boot_sector[0x43:0x47] = struct.pack('<I', new_serial)
                            elif 'FAT' in fs_name:
                                # FAT16 serial at offset 0x27
                                boot_sector[0x27:0x2B] = struct.pack('<I', new_serial)
                            
                            # Write back
                            kernel32.SetFilePointer(handle, 0, 0, 0)
                            kernel32.WriteFile(handle, boot_sector, 512,
                                ctypes.byref(bytes_returned), None)
                            kernel32.CloseHandle(handle)
                            
                            volumes_modified += 1
                            self.log("Volume", f"Drive {drive}:", "success", 
                                    f"Serial {old_serial:08X} -> {new_serial:08X}")
                        
                except Exception as e:
                    continue
            
            if volumes_modified == 0:
                self.log("Volume", "All Drives", "skip", 
                        "Could not modify volume serials (requires elevated privileges)")
                
        except Exception as e:
            self.log("Volume", "Volume Serial", "fail", str(e))

